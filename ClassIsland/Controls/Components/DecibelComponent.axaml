<controls:ComponentBase x:Class="ClassIsland.Controls.Components.DecibelComponent"
                       xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                       xmlns:local="clr-namespace:ClassIsland.Controls.Components">
    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8"
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:DecibelComponent}}">
        <TextBlock Text="{Binding CurrentDecibelText}"
                   FontWeight="Bold"
                   FontSize="{DynamicResource MainWindowBodyFontSize}"
                   VerticalAlignment="Center" />
        <StackPanel Width="92" Spacing="3" VerticalAlignment="Center">
            <ProgressBar Value="{Binding DecibelPercent}"
                         Maximum="100"
                         MinWidth="0"
                         Height="6" />
            <TextBlock Text="{Binding PeakText}"
                       FontSize="{DynamicResource MainWindowSecondaryFontSize}"
                       Classes="l-secondary" />
        </StackPanel>
    </StackPanel>
</controls:ComponentBase>
