<controls:ComponentBase x:Class="ClassIsland.Controls.Components.TomorrowWeatherComponent"
                       xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                       xmlns:widgets="clr-namespace:ClassIsland.Controls"
                       xmlns:local="clr-namespace:ClassIsland.Controls.Components">
    <Border DataContext="{Binding State, RelativeSource={RelativeSource AncestorType=local:TomorrowWeatherComponent}}"
            Background="{DynamicResource AccentFillColorDefaultBrush}"
            CornerRadius="14"
            Padding="9,2"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <TextBlock Text="明天"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                       Margin="0,1,0,-1"
                       VerticalAlignment="Center" />
            <widgets:WeatherPackIconControl Code="{Binding TomorrowWeatherCode}"
                                            Height="20"
                                            VerticalAlignment="Center" />
            <TextBlock Text="{Binding TomorrowWeatherText}"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                       Margin="0,1,0,-1"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding TomorrowRainHint}"
                       IsVisible="{Binding IsTomorrowRainy}"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                       FontWeight="SemiBold"
                       Margin="0,1,0,-1"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</controls:ComponentBase>
