<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.DecibelSettingsPage"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                           xmlns:local="clr-namespace:ClassIsland.Controls"
                           xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                           xmlns:ci="http://classisland.tech/schemas/xaml/core"
                           x:ClassModifier="public"
                           Loaded="Control_OnLoaded">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Margin="12">
            <TextBlock Text="使用指定麦克风实时检测教室音量。主界面组件只会在下方勾选的课程时段显示。"
                       Classes="l-instructive" Margin="0,0,0,12" />

            <ui:SettingsExpander Header="启用麦克风检测"
                                 Description="启用后会持续读取所选麦克风。未启用时不会占用麦克风。"
                                 IconSource="{ci:FluentIconSource &#xE720;}">
                <ui:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsDecibelMonitorEnabled, Mode=TwoWay}" />
                </ui:SettingsExpander.Footer>
            </ui:SettingsExpander>

            <ui:SettingsExpander Header="输入设备与校准" IsExpanded="True">
                <ui:SettingsExpanderItem Content="麦克风设备">
                    <ui:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="320"
                                      ItemsSource="{Binding ViewModel.DeviceNames}"
                                      SelectedItem="{Binding ViewModel.SettingsService.Settings.DecibelInputDeviceName, Mode=TwoWay}" />
                            <Button Content="刷新" Click="ButtonRefreshDevices_OnClick" />
                        </StackPanel>
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="校准偏移">
                    <ui:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider Width="220" Minimum="-30" Maximum="30" TickFrequency="1"
                                    Value="{Binding ViewModel.SettingsService.Settings.DecibelCalibrationOffset, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding ViewModel.SettingsService.Settings.DecibelCalibrationOffset, StringFormat='{}{0:+0;-0;0} dB'}" />
                        </StackPanel>
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="实时读数">
                    <Grid ColumnDefinitions="Auto,*,Auto" Width="440">
                        <TextBlock Text="{Binding ViewModel.CurrentDecibelText}"
                                   FontSize="30" FontWeight="Bold" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Margin="16,0" Value="{Binding ViewModel.DecibelPercent}"
                                     Maximum="100" MinWidth="0" />
                        <TextBlock Grid.Column="2" Text="{Binding ViewModel.PeakDecibelText}"
                                   VerticalAlignment="Center" Classes="l-secondary" />
                    </Grid>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="状态">
                    <TextBlock Text="{Binding ViewModel.StatusText}" TextWrapping="Wrap" />
                </ui:SettingsExpanderItem>
            </ui:SettingsExpander>

            <ui:SettingsExpander Header="小组件显示时段"
                                 Description="只有勾选的课程会显示“分贝显示”小组件。"
                                 IsExpanded="True">
                <StackPanel Spacing="8">
                    <ui:InfoBar IsOpen="True"
                                IsVisible="{Binding !ViewModel.HasVisibilityLessonChoices}"
                                Severity="Informational"
                                Title="还没有可勾选的课程"
                                Message="当前档案里还没有时间表或课程。请先在档案编辑器中创建时间表和课程表，保存后回到本页即可按课勾选。" />
                    <local:LessonTimePointPicker Groups="{Binding ViewModel.VisibilityGroups}" />
                </StackPanel>
            </ui:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
