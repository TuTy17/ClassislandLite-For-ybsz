<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.RemoteMessageSettingsPage"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                           xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                           xmlns:ci="http://classisland.tech/schemas/xaml/core"
                           x:ClassModifier="public">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Margin="12">
            <ui:InfoBar IsOpen="True"
                        Severity="Informational"
                        Title="远程提醒"
                        Message="启用后，本机会定时向你的消息服务器查询新通知；收到后全屏显示大字提醒，并每 5 秒响一次提示音，点击屏幕任意位置即可关闭。服务器与网页端部署见“远程提醒-部署说明”。" />

            <ui:SettingsExpander Header="启用远程提醒"
                                 Description="会按设定的间隔访问消息服务器，只接收启用之后的新消息。"
                                 IconSource="{ci:FluentIconSource &#xE7ED;}">
                <ui:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsRemoteMessageEnabled, Mode=TwoWay}" />
                </ui:SettingsExpander.Footer>
            </ui:SettingsExpander>

            <ui:SettingsExpander Header="服务器"
                                 Description="填写 Cloudflare Worker 的地址，例如 https://classisland-msg.你的账号.workers.dev"
                                 IsExpanded="True"
                                 IconSource="{ci:FluentIconSource &#xE774;}">
                <ui:SettingsExpanderItem Content="服务器地址"
                                         Description="Cloudflare Worker 的地址，末尾不要带斜杠。">
                    <ui:SettingsExpanderItem.Footer>
                        <TextBox Text="{Binding ViewModel.SettingsService.Settings.RemoteMessageServerUrl, Mode=TwoWay}"
                                 Watermark="https://classisland-msg.example.workers.dev"
                                 Width="380" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="设备访问密钥"
                                         Description="与服务器上配置的 DEVICE_KEY 一致。">
                    <ui:SettingsExpanderItem.Footer>
                        <TextBox Text="{Binding ViewModel.SettingsService.Settings.RemoteMessageAccessKey, Mode=TwoWay}"
                                 PasswordChar="●"
                                 Watermark="DEVICE_KEY"
                                 Width="380" />
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="本机设备标识"
                                         Description="要做“只发给某一台设备”时，把它填到网页端。">
                    <ui:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ViewModel.SettingsService.Settings.RemoteMessageDeviceId}"
                                       VerticalAlignment="Center"
                                       Classes="l-secondary" />
                            <Button Content="复制" Click="ButtonCopyDeviceId_OnClick" />
                        </StackPanel>
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="轮询间隔"
                                         Description="越短越及时，机器多时可以调大一点。">
                    <ui:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <NumericUpDown Width="140" Minimum="2" Maximum="120"
                                           Value="{Binding ViewModel.SettingsService.Settings.RemoteMessagePollSeconds, Mode=TwoWay}" />
                            <TextBlock Text="秒" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="提示音音量"
                                         Description="每 5 秒播放一次提醒音的音量。">
                    <ui:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider Width="200" Minimum="0" Maximum="1" TickFrequency="0.05"
                                    Value="{Binding ViewModel.SettingsService.Settings.RemoteMessageSoundVolume, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding ViewModel.SettingsService.Settings.RemoteMessageSoundVolume, StringFormat='{}{0:P0}'}" />
                        </StackPanel>
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="连接状态">
                    <TextBlock Text="{Binding ViewModel.StatusMessage}" TextWrapping="Wrap" />
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Content="测试">
                    <ui:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="测试连接" Click="ButtonTestConnection_OnClick" />
                            <Button Content="预览效果" Click="ButtonPreview_OnClick" />
                        </StackPanel>
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
            </ui:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
