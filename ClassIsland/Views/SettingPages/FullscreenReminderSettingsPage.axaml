<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.FullscreenReminderSettingsPage"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                           xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                           xmlns:ci="http://classisland.tech/schemas/xaml/core"
                           x:ClassModifier="public">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Margin="12">
            <ui:InfoBar IsOpen="True"
                        Severity="Informational"
                        Title="全屏强调提醒"
                        Message="勾选课程后，该课程开始时将播放 ClassIsland 原有的全屏波纹强调特效；未勾选的课程不会播放。" />
            <ItemsControl ItemsSource="{Binding ViewModel.LessonChoices}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Margin="0,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
